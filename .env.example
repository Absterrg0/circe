# Circe self-hosted relay source builds
# `cp .env.example .env` enables Circe remote access against YOUR relay
# deployment. These are public client identifiers, not secrets. Leave a value
# unset to build with cloud features disabled. Do not add server-side secrets
# (Clerk secret key, Cloudflare tokens, APNs keys) to this file.

# Your Clerk application's public identifiers. Get them from the Clerk
# Dashboard under API keys, JWT templates, and OAuth applications. The JWT
# template audience must match CLERK_JWT_AUDIENCE in infra/relay/.env.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_...
# T3CODE_CLERK_JWT_TEMPLATE=circe-relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=...

# Your hosted web app origin, used by the CLI out-of-band OAuth flow. The
# web build defaults to its own origin when this is unset.
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Your relay deployment URL. `infra/relay` writes this back here after a deploy.
# T3CODE_RELAY_URL=https://relay.example.com

# Optional: signed macOS passkey builds. The RP domain defaults to the Clerk
# Frontend API hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the
# override when Clerk returns a different RP ID or multiple domains must be
# entitled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/circe.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional: public, ingest-only OpenTelemetry for mobile and relay clients.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=circe-mobile-traces
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
# T3CODE_RELAY_CLIENT_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_RELAY_CLIENT_OTLP_TRACES_DATASET=circe-relay-traces
# T3CODE_RELAY_CLIENT_OTLP_TRACES_TOKEN=xaat-...

# Optional: Circe's TypeSafe System One decision tier. Set the key to enable
# natural-language classification on this node. The key stays server-side;
# never expose it to a client build. The model defaults to jev-latest.
# T3CODE_TYPESAFE_API_KEY=...
# T3CODE_TYPESAFE_MODEL=jev-latest
# T3CODE_TYPESAFE_TIMEOUT_MS=1500
# T3CODE_TYPESAFE_ENABLED=1
