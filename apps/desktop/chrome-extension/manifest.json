{
  "manifest_version": 3,
  "name": "Circe Browser Connector",
  "version": "0.1.0",
  "description": "Lets Circe control one visible tab in your own signed-in Chrome profile.",
  "key": "",
  "permissions": ["alarms", "debugger", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "116"
}
