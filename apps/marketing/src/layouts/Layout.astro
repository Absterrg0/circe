---
import { Image } from "astro:assets";
import circeIcon from "../assets/circe-icon.png";
import { APP_URL, DEMOS_URL, DOCS_URL, GITHUB_REPOSITORY_URL, RELEASES_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Circe: one assistant for all of your machines",
  description = "Circe is an open-source, voice-first control plane for coding agents. Say what you want, and it happens on the machine that owns the work. Unfinished, and built in the open.",
  pageClass,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/og.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Circe" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Circe mark: warm ribbons orbiting a dark center." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="Circe home">
          <Image
            class="brand-tile"
            src={circeIcon}
            alt=""
            width={30}
            height={30}
            densities={[1, 2, 3]}
            loading="eager"
          />
          <span class="brand-name">Circe</span>
        </a>
        <nav class="nav-links" aria-label="Sections">
          <a href="/#demos">Demos</a>
          <a href="/#how">How it works</a>
          <a href="/#status">Status</a>
        </nav>
        <a class="button button-secondary nav-github" href={GITHUB_REPOSITORY_URL} rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main" class:list={[pageClass]}>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <Image
            class="brand-tile"
            src={circeIcon}
            alt=""
            width={24}
            height={24}
            densities={[1, 2, 3]}
            loading="lazy"
          />
          <p>
            Circe is an unfinished open-source project, built on{" "}
            <a href="https://github.com/pingdotgg/t3code" rel="noopener">T3 Code</a>. MIT licensed.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={GITHUB_REPOSITORY_URL} rel="noopener">GitHub</a>
          <a href={DEMOS_URL} rel="noopener">Demos</a>
          <a href={DOCS_URL} rel="noopener">Docs</a>
          <a href={RELEASES_URL} rel="noopener">Releases</a>
          <a href={APP_URL} rel="noopener">Web app</a>
        </nav>
      </div>
    </footer>

    <script>
      const nav = document.querySelector("[data-nav]");
      const onScroll = () => nav?.classList.toggle("is-scrolled", window.scrollY > 8);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  /* Inter v4 and Instrument Serif, self-hosted. Licenses: /fonts/inter-OFL.txt, /fonts/instrument-serif-OFL.txt, /fonts/jetbrains-mono-OFL.txt. */
  @font-face {
    font-family: "Inter Variable";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("/fonts/inter-latin-wght-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Instrument Serif";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/instrument-serif-latin-400-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Instrument Serif";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/instrument-serif-latin-400-italic.woff2") format("woff2");
  }
  @font-face {
    font-family: "JetBrains Mono Variable";
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url("/fonts/jetbrains-mono-latin-wght-normal.woff2") format("woff2");
  }

  /* Circe design system v1.0, light mode. Source: assets/circe/tokens.css. */
  :root {
    --snow: #fafafa;
    --charcoal: #111113;
    --ink: #0c0c0d;
    --graphite: #18181a;
    --orange: #f26b3a;
    --orange-deep: #cc4a14;
    --peach: #ffa47a;
    --ember: #4a1a0a;

    --bg: #fafafa;
    --surface-1: #ffffff;
    --surface-2: #f4f4f5;
    --surface-3: #eeeef0;
    --text-primary: #18181b;
    --text-secondary: #63636b;
    --text-muted: #8a8a92;
    --border: #e4e4e7;
    --border-strong: #d4d4d8;
    --accent: #cc4a14;
    --accent-hover: #b53f0f;
    --accent-soft: #fdeee6;
    --success: #3fa36f;
    --success-soft: #e9f6ef;
    --warning: #d89545;
    --warning-soft: #fbf1e3;

    --radius-xs: 6px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 22px;
    --radius-pill: 999px;

    --shadow-soft: 0 8px 28px rgba(24, 24, 27, 0.08);
    --shadow-hairline: 0 1px 2px rgba(24, 24, 27, 0.04);
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --brand-gradient: linear-gradient(135deg, #4a1a0a 0%, #a8401a 38%, #f26b3a 68%, #ffa47a 100%);

    --font-sans:
      "Inter Variable", Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-serif: "Instrument Serif", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --font-mono:
      "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;

    --page: 1120px;
    --gutter: 24px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 88px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  :focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--text-primary);
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--charcoal);
    color: #fff;
    font-size: 14px;
    transition: top 150ms var(--ease);
  }
  .skip-link:focus {
    top: 12px;
  }

  .container {
    width: 100%;
    max-width: calc(var(--page) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Buttons: one filled primary per context, quiet secondary. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 150ms var(--ease),
      border-color 150ms var(--ease),
      color 150ms var(--ease),
      transform 150ms var(--ease);
  }
  .button:active {
    transform: scale(0.985);
  }
  .button-primary {
    background: var(--accent);
    color: #fff;
  }
  .button-primary:hover {
    background: var(--accent-hover);
  }
  .button-secondary {
    background: var(--surface-1);
    border-color: var(--border-strong);
    color: var(--text-primary);
    box-shadow: var(--shadow-hairline);
  }
  .button-secondary:hover {
    border-color: #b9b9c0;
    background: var(--surface-2);
  }

  /* Navigation */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: rgba(250, 250, 250, 0.72);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    transition: border-color 200ms var(--ease);
  }
  .nav.is-scrolled {
    border-bottom-color: var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: calc(var(--page) + var(--gutter) * 2);
    height: 64px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .brand-tile {
    border-radius: 8px;
    flex: none;
  }
  .brand-name {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .nav-links a {
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    transition:
      color 150ms var(--ease),
      background-color 150ms var(--ease);
  }
  .nav-links a:hover {
    color: var(--text-primary);
    background: var(--surface-2);
  }
  .nav-github {
    height: 38px;
    padding: 0 14px;
    font-size: 14px;
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface-1);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    max-width: calc(var(--page) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 28px var(--gutter);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 14px;
  }
  .footer-brand a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .footer-links a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
    .nav-github {
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
