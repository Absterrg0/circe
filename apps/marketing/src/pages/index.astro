---
import { Image } from "astro:assets";
import circeMark from "../assets/circe-mark.png";
import Layout from "../layouts/Layout.astro";
import { DEMOS_URL, GITHUB_REPOSITORY_URL, INSTALL_DOC_URL, RELEASES_URL } from "../lib/site";

// Every transcript below is copied from a real run of the scripts in demos/.
// When the demos change, rerun them and update these.
const groundingTurns = [
  {
    say: "start a task in Rivvl to fix the login bug",
    tone: "ok",
    chip: "Exact match",
    result: "Routes to Rivvl on desktop",
    detail: "Heard “Rivvl”. Nothing to correct.",
  },
  {
    say: "start a task in rival to fix the login bug",
    tone: "ok",
    chip: "Near match",
    result: "Routes to Rivvl on desktop",
    detail: "Heard “rival”. Sends “start a task in Rivvl to fix the login bug”.",
  },
  {
    say: "I need you to check out Zivil.",
    tone: "ask",
    chip: "Asks first",
    result: "“Did you mean Rivvl?”",
    detail: "Heard “Zivil”. Will not act until you confirm.",
  },
  {
    say: "Open Portfolio.",
    tone: "ask",
    chip: "Asks which",
    result: "“More than one project matches “Portfolio”. Which one did you mean?”",
    detail: "Portfolio on laptop, or Portfolio on build-box.",
  },
] as const;

const typingGoals = [
  {
    goal: "search for weather in Ahmedabad on the browser",
    candidates: ["weather", "search for weather in Ahmedabad", "search for weather in"],
    count: 31,
    done: "The screen shows the result the goal names.",
  },
  {
    goal: "click the Save button",
    candidates: ["click the Save button", "click the Save", "click"],
    count: 10,
    done: "“the Save button” was activated once.",
  },
  {
    goal: "save the notes as groceries.txt",
    candidates: ["save the notes as groceries.txt", "save the notes as", "save the notes"],
    count: 15,
    done: "There is evidence the file or content was saved.",
  },
] as const;

const agentReport = `## Fixed the login redirect

The callback handler dropped the \`next\` parameter when the session cookie was already set. I now carry it through the redirect and added a test for the signed-in case.

\`\`\`ts
const next = url.searchParams.get("next") ?? "/";
return redirect(sanitizeNext(next));
\`\`\`

**Checks:** 14 tests pass, typecheck clean. The change is on branch \`fix/login-redirect\` and is ready for review.`;

const spokenSummary =
  "Fixed the login redirect The callback handler dropped the next parameter when the session cookie was already set. I now carry it through the redirect and added a test for the signed-in case. The code details are waiting in your workspace. Checks: 14 tests pass, typecheck clean.…";

const runCommands = `git clone https://github.com/Absterrg0/circe && cd circe
vp i
node demos/01-ground-a-spoken-request.ts`;

const pillars = [
  {
    icon: "mic",
    title: "Voice you can trust",
    body: "A spoken request is matched against the real projects, tasks, and machines you have. When a name is unclear, Circe asks. A model never invents an id or picks between two matches on its own.",
  },
  {
    icon: "machines",
    title: "Many machines, one assistant",
    body: "Each machine owns its projects, credentials, and history. Work runs on the machine that owns the project, or the one you name. A disconnected machine is reported, never swapped for another.",
  },
  {
    icon: "pointer",
    title: "Desktop use that asks first",
    body: "Circe can open apps, click, type, and scroll in your own signed-in apps. It repeats the goal before it touches anything, types only words you said, and reports done only when the screen shows it.",
  },
] as const;

const steps = [
  { title: "You speak or type", body: "From the desktop orb, the hotkey, or your phone." },
  {
    title: "Grounded",
    body: "Names are resolved against real machine, project, agent, and task catalogs.",
  },
  {
    title: "A closed plan",
    body: "The deterministic Director returns typed commands. Nothing free-form is dispatched.",
  },
  {
    title: "Runs where it lives",
    body: "The machine that owns the project runs your own coding agent on it.",
  },
  { title: "Reported back", body: "On screen in full, and aloud as a short summary." },
] as const;

const status = [
  {
    area: "Coding-agent foundation",
    note: "Orchestration, providers, Git, terminals, approvals. Inherited from T3 Code.",
    state: "Solid",
    tone: "ok",
  },
  {
    area: "Grounded voice routing",
    note: "Against real project and task catalogs. Covered by the demos and their tests.",
    state: "Works",
    tone: "ok",
  },
  {
    area: "Multi-machine pairing and remote control",
    note: "Local network, Tailscale, SSH, and relay routes to the same machine.",
    state: "Works",
    tone: "ok",
  },
  {
    area: "Live spoken conversation",
    note: "Needs a Circe Mesh link or your own OpenAI API key.",
    state: "Rough",
    tone: "rough",
  },
  {
    area: "Desktop and browser use",
    note: "Fine for simple goals. Longer goals fail too often for a product.",
    state: "Rough",
    tone: "rough",
  },
  {
    area: "Cross-machine plans",
    note: "“Get the file from laptop A, use it on laptop B.” The workflow engine the idea needs.",
    state: "Not built",
    tone: "none",
  },
] as const;

const agents = ["Claude Code", "Codex", "Cursor", "Grok Build", "OpenCode", "Antigravity"];
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="pill reveal">
        <span class="pill-dot" aria-hidden="true"></span>
        Work in progress, built in the open
      </p>
      <h1 class="display reveal">
        Your work. <em>Everywhere.</em>
      </h1>
      <p class="lede reveal">
        Circe is one assistant for all of your machines. Say what you want, and it happens on the
        machine that owns the work, using the coding agents you already pay for.
      </p>
      <div class="hero-actions reveal">
        <a class="button button-primary" href="#demos">See the demos</a>
        <a class="button button-secondary" href={GITHUB_REPOSITORY_URL} rel="noopener">
          Read the code
        </a>
      </div>
    </div>

    <!-- The one brand moment: a command box over a warm glow and a horizon line. -->
    <div class="container">
      <figure class="stage reveal" aria-label="Illustration: a spoken request routed to the machine that owns the project">
        <div class="stage-glow" aria-hidden="true"></div>
        <div class="command">
          <span class="command-mic" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="3" width="6" height="11" rx="3"></rect>
              <path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path>
            </svg>
          </span>
          <span class="command-text">
            start a task in <span class="heard">rival</span> to fix the login bug
          </span>
          <span class="command-key">Ctrl Shift J</span>
        </div>

        <div class="route" aria-hidden="true">
          <span class="route-line"></span>
          <span class="route-note">
            heard “rival” <span class="route-arrow">→</span> <strong>Rivvl</strong>, on Desktop
          </span>
        </div>

        <ul class="machines">
          <li class="machine is-target">
            <div class="machine-head">
              <span class="machine-name">Desktop</span>
              <span class="state state-running"><i></i>Running</span>
            </div>
            <p class="machine-project">Rivvl</p>
            <p class="machine-task">Fix the login bug · Claude Code</p>
          </li>
          <li class="machine">
            <div class="machine-head">
              <span class="machine-name">Laptop</span>
              <span class="state state-idle"><i></i>Online</span>
            </div>
            <p class="machine-project">Portfolio</p>
            <p class="machine-task">Nothing running</p>
          </li>
          <li class="machine">
            <div class="machine-head">
              <span class="machine-name">Build box</span>
              <span class="state state-idle"><i></i>Online</span>
            </div>
            <p class="machine-project">Portfolio</p>
            <p class="machine-task">Nothing running</p>
          </li>
        </ul>
        <figcaption>
          An illustration. The routing in it is real output from the first demo below.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What it is</p>
        <h2 class="heading">An operator, not a chat window.</h2>
        <p class="section-lede">
          Circe sits on top of the coding agents you already use and gives you one calm way to
          direct them, by voice or text, across every machine you own.
        </p>
      </div>
      <div class="pillars">
        {
          pillars.map((pillar) => (
            <article class="card pillar reveal">
              <span class="pillar-icon" aria-hidden="true">
                {pillar.icon === "mic" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="3" width="6" height="11" rx="3" />
                    <path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
                  </svg>
                )}
                {pillar.icon === "machines" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="12" height="9" rx="1.5" />
                    <path d="M7 17h4M9 13v4" />
                    <rect x="17" y="8" width="4" height="9" rx="1" />
                  </svg>
                )}
                {pillar.icon === "pointer" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 4 5.2 14 2.1-5.7L18 10.2 5 4Z" />
                    <path d="m13 13 5 5" />
                  </svg>
                )}
              </span>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Demos -->
  <section class="section section-tint" id="demos">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Demos</p>
        <h2 class="heading">See it decide.</h2>
        <p class="section-lede">
          These are real outputs. Each one comes from a script in the repository that runs with no
          microphone, no account, and no server.
        </p>
      </div>

      <div class="demos reveal" data-tabs>
        <div class="tablist" role="tablist" aria-label="Demos">
          <button class="tab" role="tab" id="tab-ground" aria-controls="panel-ground" aria-selected="true">
            <span class="tab-index">01</span>
            <span>Misheard names</span>
          </button>
          <button class="tab" role="tab" id="tab-type" aria-controls="panel-type" aria-selected="false" tabindex="-1">
            <span class="tab-index">02</span>
            <span>Only your words</span>
          </button>
          <button class="tab" role="tab" id="tab-speak" aria-controls="panel-speak" aria-selected="false" tabindex="-1">
            <span class="tab-index">03</span>
            <span>Spoken reports</span>
          </button>
        </div>

        <div class="card panel" role="tabpanel" id="panel-ground" aria-labelledby="tab-ground">
          <div class="panel-copy">
            <h3>A misheard project name does not send work to the wrong repository.</h3>
            <p>
              Speech recognition gets names wrong, and an assistant that guesses acts on the wrong
              code. Circe corrects a close mishearing, asks about a distant one, and asks which
              machine when two own the same name.
            </p>
          </div>
          <ol class="turns">
            {
              groundingTurns.map((turn) => (
                <li class="turn">
                  <p class="turn-say">
                    <span class="who">You say</span>“{turn.say}”
                  </p>
                  <div class="turn-answer">
                    <span class:list={["chip", `chip-${turn.tone}`]}>{turn.chip}</span>
                    <p class="turn-result">{turn.result}</p>
                    <p class="turn-detail">{turn.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="card panel" role="tabpanel" id="panel-type" aria-labelledby="tab-type">
          <div class="panel-copy">
            <h3>Circe can only type words you said.</h3>
            <p>
              On a real desktop the model never writes free text into your apps. It picks from a
              closed list of spans cut from your instruction, so a web page with hidden instructions
              cannot make it type something else. What counts as done is fixed before the first
              click.
            </p>
          </div>
          <ul class="goals">
            {
              typingGoals.map((item) => (
                <li class="goal">
                  <p class="goal-text">
                    <span class="who">Goal</span>
                    {item.goal}
                  </p>
                  <div class="goal-row">
                    <span class="goal-label">May type</span>
                    <span class="spans">
                      {item.candidates.map((text) => (
                        <code>{text}</code>
                      ))}
                      <span class="spans-more">{item.count} spans, all from the goal</span>
                    </span>
                  </div>
                  <div class="goal-row">
                    <span class="goal-label">Done when</span>
                    <span>{item.done}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card panel" role="tabpanel" id="panel-speak" aria-labelledby="tab-speak">
          <div class="panel-copy">
            <h3>A written report becomes something worth hearing.</h3>
            <p>
              An agent finishes with Markdown, code fences, and file paths. Reading that aloud is
              useless. The full report stays in the task. Speech gets whole sentences inside a
              budget, with the code replaced by one plain line.
            </p>
          </div>
          <div class="report">
            <div class="report-side">
              <span class="who">The agent wrote</span>
              <pre>{agentReport}</pre>
            </div>
            <div class="report-side report-spoken">
              <span class="who">Circe says</span>
              <p>{spokenSummary}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="run reveal">
        <div class="run-copy">
          <h3>Run them yourself</h3>
          <p>
            Node 24 and <a href="https://viteplus.dev/guide/" rel="noopener">Vite+</a>. The full
            output and source are in <a href={DEMOS_URL} rel="noopener">demos/</a>.
          </p>
        </div>
        <div class="code">
          <pre data-copy-source>{runCommands}</pre>
          <button class="copy" type="button" data-copy aria-label="Copy commands">Copy</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Voice moment: the one dark surface on the page. -->
  <section class="section">
    <div class="container">
      <div class="voice reveal">
        <div class="voice-orb" aria-hidden="true">
          <span class="voice-ring"></span>
          <Image src={circeMark} alt="" width={220} height={220} densities={[1, 2]} loading="lazy" />
        </div>
        <div class="voice-copy">
          <p class="voice-state"><i aria-hidden="true"></i>Listening…</p>
          <h2 class="heading heading-light">Talk to it the way you would brief a colleague.</h2>
          <p>
            Press the hotkey and speak. Ask what is running, start work on a named machine, answer
            an agent’s question, or approve a request. Circe tells you what it did, and asks when
            it is not sure what you meant.
          </p>
          <ul class="says">
            <li>“What’s running?”</li>
            <li>“On Desktop, fix the login bug.”</li>
            <li>“Open the calculator and add 12 and 30.”</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">How it works</p>
        <h2 class="heading">The model normalizes language. It never holds the wheel.</h2>
        <p class="section-lede">
          Every request takes the same path, and every step on it is typed and inspectable in the
          repository.
        </p>
      </div>
      <ol class="steps reveal">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="agents reveal">
        <p>Directs the agents you already have</p>
        <ul>
          {agents.map((agent) => <li>{agent}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Status -->
  <section class="section section-tint" id="status">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Status</p>
        <h2 class="heading">Where it stands, plainly.</h2>
        <p class="section-lede">
          Circe is not a finished product. This is a prototype I am building in the open, and this
          is the state of each part today.
        </p>
      </div>
      <div class="card status reveal">
        {
          status.map((row) => (
            <div class="status-row">
              <div>
                <h3>{row.area}</h3>
                <p>{row.note}</p>
              </div>
              <span class:list={["chip", `chip-${row.tone}`]}>{row.state}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="section closing">
    <div class="container">
      <div class="closing-card reveal">
        <h2 class="display display-small">Think. Do. <em>Across your machines.</em></h2>
        <p>
          The code is public and MIT licensed. Read it, run the demos, or try a build and tell me
          where it breaks.
        </p>
        <div class="closing-actions">
          <a class="button button-light" href={GITHUB_REPOSITORY_URL} rel="noopener">
            View on GitHub
          </a>
          <a class="button button-ghost" href={RELEASES_URL} rel="noopener">Desktop builds</a>
          <a class="button button-ghost" href={INSTALL_DOC_URL} rel="noopener">Install guide</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Reveal on scroll. Content is visible without JavaScript; the class that
  // hides it is only added here.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealed = document.querySelectorAll<HTMLElement>(".reveal");
  if (!reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("has-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
    );
    for (const element of revealed) observer.observe(element);
  }

  // Tabs. Without JavaScript every panel stays visible, stacked.
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (next: HTMLButtonElement, focus: boolean) => {
      for (const tab of tabs) {
        const selected = tab === next;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !selected;
      }
      if (focus) next.focus();
    };
    root.classList.add("is-tabbed");
    const first = tabs[0];
    if (first) select(first, false);
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const target = tabs[(index + step + tabs.length) % tabs.length];
        if (target) select(target, true);
      });
    });
  }

  // Copy the run commands.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const source = button.parentElement?.querySelector("[data-copy-source]");
      if (!source?.textContent) return;
      try {
        await navigator.clipboard.writeText(source.textContent);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      window.setTimeout(() => (button.textContent = "Copy"), 1800);
    });
  }
</script>

<style>
  /* Reveal */
  :global(html.has-reveal) .reveal {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 420ms var(--ease),
      transform 420ms var(--ease);
  }
  :global(html.has-reveal) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* Type */
  .display {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(52px, 9vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .display em {
    font-style: italic;
  }
  .display-small {
    font-size: clamp(38px, 5.6vw, 64px);
    line-height: 1.04;
  }
  .heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .eyebrow {
    margin-bottom: 14px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .who {
    display: block;
    margin-bottom: 4px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Sections */
  .section {
    padding: 96px 0;
  }
  .section-tint {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-1);
  }
  .section-head {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .section-lede {
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 18px;
    line-height: 1.6;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    box-shadow: var(--shadow-hairline);
  }
  .section-tint .card {
    background: var(--bg);
  }

  /* Chips: color always paired with text. */
  .chip {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .chip-ok {
    background: var(--success-soft);
    color: #1f6f48;
  }
  .chip-ask,
  .chip-rough {
    background: var(--warning-soft);
    color: #8a5310;
  }
  .chip-none {
    background: var(--surface-3);
    color: var(--text-secondary);
  }

  /* Hero */
  .hero {
    padding: 72px 0 40px;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 14px 0 12px;
    margin-bottom: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-1);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    box-shadow: var(--shadow-hairline);
  }
