+import { resolveLibPath as resolvePackagedLibPath } from "@ubjs/node/typescript/dist/resolve-lib.js";
+// Circe patch: inside a packaged Electron app the platform package resolves
+// under app.asar, where the dynamic loader cannot open files. Electron only
+// redirects process.dlopen to app.asar.unpacked; this library is opened by
+// its own FFI loader, so the redirect happens here for every caller.
+const resolveLibPath = (options) => {
+    const path = resolvePackagedLibPath(options);
+    const unpacked = path.replace(/([\\/])app\.asar([\\/])/, "$1app.asar.unpacked$2");
+    return unpacked !== path && existsSync(unpacked) ? unpacked : path;
+};
